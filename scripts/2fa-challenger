#!/usr/bin/env python3
"""
2FA-challenger — genera el desafio y crea la accion pendiente.

Uso:
  2fa-challenger "<accion_sensible>"  -> imprime JSON {challenge, nonce}

El agente usa el challenge para mostrarlo en el chat y el nonce para
lanzar 2fa-wait en background con notify_on_complete=true. El gateway
notifica al agente cuando 2fa-wait termina (CONFIRMED/TIMEOUT) y el
agente revela la respuesta de forma autonoma.

Este script SOLO genera el challenge y lanza poller+webform. NO espera.
NO lanza 2fa-wait: eso es responsabilidad del agente.
"""
import os
import sys
import time
import json
import secrets
import subprocess
from pathlib import Path

BASE = Path(os.environ.get("HERMES_2FA_DIR", "/home/michael/.hermes/2fa"))
PENDING_DIR = BASE / "pending"
TTL = 300  # 5 minutos


def main():
    if len(sys.argv) < 2:
        print("Uso: 2fa-challenger \"<accion_sensible>\"", file=sys.stderr)
        sys.exit(1)

    action = sys.argv[1]

    # Lifecycle step 0: cleanup INICIAL COMPLETO (procesos + archivos huerfanos)
    # ESTO DEBE IR ANTES de crear el nuevo pending file
    stop_childs_script = BASE / "2fa-stop-childs"
    if stop_childs_script.exists():
        subprocess.run(
            [sys.executable, str(stop_childs_script), "stop"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    # Limpia pending/ tokens/ huerfanos (challenges expirados o previos)
    PENDING_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        for f in PENDING_DIR.glob("*.json"):
            f.unlink(missing_ok=True)
        tokens_dir = BASE / "tokens"
        if tokens_dir.exists():
            for f in tokens_dir.glob("*.token"):
                f.unlink(missing_ok=True)
    except Exception:
        pass
    # Limpia result files temporales previos
    try:
        for f in Path("/tmp").glob("2fa-result-*.json"):
            f.unlink(missing_ok=True)
    except Exception:
        pass
    # Mata 2fa-wait huerfanos (bracket-safe)
    try:
        subprocess.run(
            ["pkill", "-f", "[2]fa-wait"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass

    # AHORA SÍ: genera el nuevo challenge
    nonce = secrets.token_hex(8)
    challenge = secrets.token_hex(16)
    pending = {
        "action": action,
        "created": time.time(),
        "expires": time.time() + TTL,
        "nonce": nonce,
    }
    (PENDING_DIR / f"{challenge}.json").write_text(json.dumps(pending))
    os.chmod(PENDING_DIR / f"{challenge}.json", 0o600)

    # Lifecycle step 1: lanza poller + webform limpios para ESTE challenge
    if stop_childs_script.exists():
        subprocess.run(
            [sys.executable, str(stop_childs_script), "start", challenge],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    # Imprime JSON para que el agente capture challenge+nonce
    print(json.dumps({"challenge": challenge, "nonce": nonce}))


if __name__ == "__main__":
    main()
